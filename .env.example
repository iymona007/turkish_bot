# Majburiy: @BotFather dan olingan token
BOT_TOKEN=

# YANGI SO'ZLAR (hammasi ixtiyoriy). Bo'sh qoldirsangiz, bot 250 dan ortiq ichki so'z bilan pulsiz ishlaydi.
# Bepul variant: aistudio.google.com/apikey dan Gemini kalitini oling (karta kerak emas).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Pullik variant (console.anthropic.com). Ikkalasi ham bo'lsa, Claude ishlatiladi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ixtiyoriy: xato xabarlari va /admin buyrug'i uchun sizning Telegram ID raqamingiz
ADMIN_ID=

# Vaqt zonasi va standart sozlamalar (yangi foydalanuvchilar uchun)
TIMEZONE=Asia/Tashkent
DEFAULT_SEND_TIME=09:00
DEFAULT_WORDS_PER_DAY=5

# Test uzunligi va bir martada yaratiladigan yangi so'zlar soni
QUIZ_LENGTH=10
GENERATE_BATCH=50

# Ma'lumotlar papkasi (SQLite baza va audio keshi)
DATA_DIR=data
